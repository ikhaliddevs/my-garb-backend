NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mygarb_phasonable
FRONTEND_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173
# Tests use only this separate database; never the development database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/mygarb_phasonable_test

# Required: generate 32 random bytes as 64 hex characters; never commit a real secret.
JWT_SECRET=
SESSION_TTL_SECONDS=3600
# Admin setup reads ADMIN_SETUP_CONFIRM, ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD
# from your private shell environment; no default administrator is created.
