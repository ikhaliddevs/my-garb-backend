    {
      "name": "M2 Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-MYGARB-Request",
                "value": "1"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"role\": \"customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('authPassword')) throw new Error('Set authPassword privately in your local Postman environment first');",
                  "pm.environment.set('customerEmail', 'customer-' + Date.now() + '@example.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', () => pm.response.to.have.status(201));",
                  "pm.test('Safe customer user', () => { const u=pm.response.json().data.user; pm.expect(u.role).to.eql('customer'); pm.expect(u).not.to.have.property('passwordHash'); pm.expect(u).not.to.have.property('password'); });"
                ]
              }
            }
          ]
        },
