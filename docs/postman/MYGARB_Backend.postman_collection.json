{
  "info": {
    "name": "MY GARB Backend - Milestones 1 and 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start API and MongoDB; select MY GARB Local. Set authPassword privately before running. Authentication POSTs send X-MYGARB-Request: 1 and JSON. Login stores HttpOnly cookie in the Postman cookie jar; logout revokes it. Do not export populated credentials or cookies. The collection creates new customer/designer demo records; it does not delete development data. Registration generates unique local emails. Full run stays within the default 10 auth attempts/15 minutes; repeated runs may require waiting."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/live",
        "description": "Liveness; no authentication or request body."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Expected response', () => { pm.expect(pm.response.json()).to.eql({success:true,data:{status:'alive'}}); });"
            ]
          }
        }
      ]
    },
    {
